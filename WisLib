local function EnsureFolder(path)
	if not HasFiles then return false end
	local cur = ""
	for part in path:gmatch("[^/\\]+") do
		cur = cur == "" and part or (cur .. "/" .. part)
		if not isfolder(cur) then pcall(makefolder, cur) end
	end
	return true
end
