local function IconId(name)
	if name == nil or name == "" then return nil end
	if type(name) == "number" then return "rbxassetid://" .. name end
	local s = tostring(name)
	if s:find("rbxasset") or s:find("http") then return s end
	if s:match("^%d+$") then return "rbxassetid://" .. s end
	local id = WisLib.Icons[s] or WisLib.Icons[s:sub(1, 1):upper() .. s:sub(2)]
	return id and ("rbxassetid://" .. id) or nil
end
