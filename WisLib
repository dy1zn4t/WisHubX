	function Config:Register(flag, el)
		local base, n = flag, 2
		while self.Elements[flag] do flag = base .. "_" .. n n += 1 end
		el.Flag = flag
		self.Elements[flag] = el
		table.insert(self.Order, flag)
		WisLib.Flags[flag] = el
		Window.Flags[flag] = el
		if self.Pending and self.Pending[flag] ~= nil then
			self.Applying = true
			pcall(function() el:Set(self.Pending[flag]) end)
			self.Applying = false
		end
		return flag
	end
	function Config:Collect()
		local data = {}
		for flag, el in pairs(self.Elements) do
			if el.Save ~= false and el.Get then
				local ok, v = pcall(function() return el:Get() end)
				if ok and v ~= nil then
