local function Escape(s) return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
local function Rich(text)
	text = tostring(text or "")
	local out, last = {}, 1
	for s, name, body, e in text:gmatch("()%[(%a+)%](.-)%[/%]()") do
		local c = COLORS[name]
		if c then
			table.insert(out, Escape(text:sub(last, s - 1)))
			table.insert(out, string.format('<font color="#%02X%02X%02X">%s</font>', math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5), Escape(body)))
			last = e
		end
	end
	table.insert(out, Escape(text:sub(last)))
	return table.concat(out)
end
