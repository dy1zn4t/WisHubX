local function Glyph(kind, parent, s, color, z)
	s = s or 14
	z = z or 15
	local g = New("Frame", { Name = "Glyph", Parent = parent, Size = UDim2.fromOffset(s, s), BackgroundTransparency = 1, ZIndex = z })
	local t = math.max(1.6, s / 8)
	if kind == "chev" then
		Bar(g, s * 0.5, t, -s * 0.16, 0, 45, color, z)
		Bar(g, s * 0.5, t, s * 0.16, 0, -45, color, z)
	elseif kind == "chevr" then
		Bar(g, s * 0.5, t, 0, -s * 0.16, 45, color, z)
		Bar(g, s * 0.5, t, 0, s * 0.16, -45, color, z)
	elseif kind == "x" then
		Bar(g, s * 0.78, t, 0, 0, 45, color, z)
		Bar(g, s * 0.78, t, 0, 0, -45, color, z)
	elseif kind == "minus" then
		Bar(g, s * 0.7, t, 0, 0, 0, color, z)
	elseif kind == "search" then
		local ring = New("Frame", { Parent = g, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, -s * 0.08, 0.5, -s * 0.08), Size = UDim2.fromOffset(s * 0.58, s * 0.58),
			BackgroundTransparency = 1, ZIndex = z }, { Corner(s), New("UIStroke", { Color = color, Thickness = t }) })
		Bar(g, s * 0.32, t, s * 0.26, s * 0.26, 45, color, z)
	elseif kind == "lock" then
		New("Frame", { Parent = g, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -1), Size = UDim2.fromOffset(s * 0.7, s * 0.5), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z }, { Corner(2) })
		New("Frame", { Parent = g, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 1), Size = UDim2.fromOffset(s * 0.46, s * 0.55), BackgroundTransparency = 1, ZIndex = z },
			{ Corner(s), New("UIStroke", { Color = color, Thickness = t }) })
	elseif kind == "key" then
		New("Frame", { Parent = g, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(s * 0.9, s * 0.62), BackgroundTransparency = 1, ZIndex = z },
			{ Corner(3), New("UIStroke", { Color = color, Thickness = t * 0.8 }) })
		Bar(g, s * 0.42, t * 0.8, 0, s * 0.12, 0, color, z)
	elseif kind == "warn" then
		Bar(g, t, s * 0.42, 0, -s * 0.08, 0, color, z)
		Bar(g, t, t, 0, s * 0.3, 0, color, z)
	end
	return g
end
local function SetGlyphColor(g, color, t)
	for _, d in ipairs(g:GetDescendants()) do
		if d:IsA("Frame") and d.BackgroundTransparency < 1 then if t then Tween(d, t, { BackgroundColor3 = color }) else d.BackgroundColor3 = color end end
		if d:IsA("UIStroke") then if t then Tween(d, t, { Color = color }) else d.Color = color end end
	end
end
