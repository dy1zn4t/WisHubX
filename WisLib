									mk = New("Frame", { Parent = ob, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(7, 7), Rotation = 45, BackgroundColor3 = sel and T.M1 or T.Pop, ZIndex = 113 },
										{ Stroke(sel and T.M1 or T.Faint) })
								end
								New("TextLabel", { Parent = ob, Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -36, 1, 0), BackgroundTransparency = 1, Text = o, FontFace = Fnt(W.Medium), TextSize = 12,
									TextColor3 = sel and T.Text or T.Muted, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 113 })
								OnEnter(ob, function() Tween(ob, 0.1, { BackgroundTransparency = 0 }) end)
								OnLeave(ob, function() Tween(ob, 0.1, { BackgroundTransparency = 1 }) end)
								ob.MouseButton1Click:Connect(function()
									if multi then
										local v = table.clone(El.Value)
										local idx = table.find(v, o)
										if idx then table.remove(v, idx) else table.insert(v, o) end
										El:Set(v)
										rebuild()
									else
										El:Set(o)
										closePopup()
									end
								end)
							end
						end
						if shown == 0 then
							New("TextLabel", { Parent = sc, Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = #El.Options == 0 and "No options yet." or ('Nothing matches "' .. query .. '".'),
								FontFace = Fnt(W.Medium), TextSize = 11, TextColor3 = T.Faint, ZIndex = 112 }, { Pad(8) })
						end
						if footLbl then footLbl.Text = #El.Value == 0 and (ecfg.EmptyHint or "Empty means any") or (#El.Value .. " picked") end
					end
					listFrame = { Rebuild = rebuild }
					if multi then
						local foot = New("Frame", { Parent = popup, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, ZIndex = 111 })
						New("Frame", { Parent = foot, Position = UDim2.fromOffset(-4, 0), Size = UDim2.new(1, 8, 0, 1), BackgroundColor3 = T.Line, BorderSizePixel = 0, ZIndex = 111 })
						footLbl = New("TextLabel", { Parent = foot, Position = UDim2.fromOffset(6, 2), Size = UDim2.new(1, -60, 1, -2), BackgroundTransparency = 1, Text = "", FontFace = Fnt(W.Medium), TextSize = 10,
							TextColor3 = T.Faint, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 112 })
						local clr = New("TextButton", { Parent = foot, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 2), Size = UDim2.fromOffset(44, 22), BackgroundTransparency = 1, Text = "Clear",
							FontFace = Fnt(W.SemiBold), TextSize = 11, TextColor3 = T.Muted, ZIndex = 112, AutoButtonColor = false })
						clr.MouseButton1Click:Connect(function() El:Set({}) rebuild() end)
					end
					rebuild()
				end
				field.MouseButton1Click:Connect(function() if popup then closePopup() else openPopup() end end)
				OnEnter(field, function() if not popup then Tween(fst, 0.12, { Color = T.M3 }) end end)
				OnLeave(field, function() if not popup then Tween(fst, 0.12, { Color = T.Stroke }) end end)
				function El:Set(v, silent)
					v = norm(v)
					if not multi and v ~= nil and not table.find(self.Options, v) and ecfg.AllowCustom ~= true then
					end
					self.Value = v
					render()
					if not silent then Safe(ecfg.Callback, multi and table.clone(v) or v) end
					Config:Changed()
				end
				function El:Get() return multi and table.clone(self.Value) or self.Value end
				function El:SetOptions(list, keep)
					self.Options = {}
					for _, o in ipairs(list or {}) do table.insert(self.Options, tostring(o)) end
					if not keep then
						if multi then
							local v = {}
							for _, x in ipairs(self.Value) do if table.find(self.Options, x) then table.insert(v, x) end end
							self.Value = v
						elseif self.Value and not table.find(self.Options, self.Value) then
							self.Value = ecfg.AllowNone and nil or self.Options[1]
						end
					end
					render()
					if popup then closePopup() end
				end
				El.Refresh = El.SetOptions
				function El:AddOption(o) table.insert(self.Options, tostring(o)) end
				function El:Clear() self:Set(multi and {} or nil) end
				render()
				ApplyCommon(El, ui, ecfg)
				Config:Register(AutoFlag("Dropdown", ecfg), El)
				return El
			end
			function Section:AddSubSection(t)
				local title = type(t) == "table" and (t.Title or t[1]) or tostring(t)
				local order = NextOrder()
				local row = New("Frame", { Parent = box, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, ZIndex = 14, LayoutOrder = order }, { Pad(12, 12, 8, 0) })
				if order > 1 then New("Frame", { Parent = row, Position = UDim2.fromOffset(-12, -8), Size = UDim2.new(1, 24, 0, 1), BackgroundColor3 = T.Line, BorderSizePixel = 0, ZIndex = 14 }) end
				New("Frame", { Parent = row, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(5, 5), Rotation = 45, BackgroundColor3 = T.M3, BorderSizePixel = 0, ZIndex = 14 })
				New("TextLabel", { Parent = row, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -14, 1, 0), BackgroundTransparency = 1, Text = title, FontFace = Fnt(W.SemiBold), TextSize = 11,
					TextColor3 = T.Faint, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 14 })
				ItemOrder = order
				local nextRowFix
				nextRowFix = box.ChildAdded:Connect(function(c)
					nextRowFix:Disconnect()
					task.defer(function() local d = c:FindFirstChild("Div") if d then d:Destroy() end end)
				end)
				return { SetVisible = function(_, v) row.Visible = v end }
			end
			return Section
		end
		return Tab
	end
	Window.CreateTab = Window.AddTab
	local function RunSearch(q)
		q = (q or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
		for _, c in ipairs(ResultsPage:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
		if q == "" then
			ResultsPage.Visible = false
			if Window.ActiveTab then Window.ActiveTab.Page.Visible = true PageTitle.Text = Window.ActiveTab.Name Marker.Visible = true end
			for _, el in ipairs(Window.Elements) do
				if el._home and el._ui.Row.Parent ~= el._home then el._ui.Row.Parent = el._home end
			end
			return
		end
		Window:CloseDropdowns()
		for _, el in ipairs(Window.Elements) do
			if el._home and el._ui.Row.Parent ~= el._home then el._ui.Row.Parent = el._home end
		end
		if Window.ActiveTab then Window.ActiveTab.Page.Visible = false end
		ResultsPage.Visible = true
		Marker.Visible = false
		PageTitle.Text = "Search"
		local groups, order = {}, 0
		for _, el in ipairs(Window.Elements) do
			if el.Type ~= "Paragraph" and el._search and el._search:find(q, 1, true) then
				local key = el._tab.Name .. "/" .. el._section.Title
				local g = groups[key]
				if not g then
					order += 1
					local h = New("Frame", { Parent = ResultsPage, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 12 }, { List(nil, 6) })
					New("TextLabel", { Parent = h, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, RichText = true,
						Text = '<font color="#676A72">' .. Escape(el._tab.Name) .. "</font>   " .. Escape(el._section.Title), FontFace = Fnt(W.Bold), TextSize = 12, TextColor3 = T.Text,
						TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13, LayoutOrder = 1 }, { Pad(2) })
					local b = New("Frame", { Parent = h, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Panel, ZIndex = 13, LayoutOrder = 2 }, { Corner(8), Stroke(T.Line), List(nil, 0) })
					g = { box = b }
					groups[key] = g
				end
				el._home = el._home or el._ui.Row.Parent
				el._ui.Row.Parent = g.box
			end
		end
		if order == 0 then
			New("TextLabel", { Parent = ResultsPage, Size = UDim2.new(1, 0, 0, 120), BackgroundTransparency = 1, RichText = true,
				Text = 'Nothing matches "' .. Escape(q) .. '".\n<font size="11" color="#676A72">Try a feature name, like Auto Farm or ESP.</font>',
				FontFace = Fnt(W.SemiBold), TextSize = 13, TextColor3 = T.Text, ZIndex = 13 })
		end
	end
	if Window.SearchBox then
		Window.SearchBox:GetPropertyChangedSignal("Text"):Connect(function() RunSearch(Window.SearchBox.Text) end)
	end
	function Window:AddConfigSection(tab, opts)
		opts = opts or {}
		tab = tab or self:AddTab({ Name = "Config", Icon = "Floppy" })
		local sec = tab:AddSection({ Title = opts.Title or "Config", Icon = "Floppy", Open = true })
		local nameBox = sec:AddInput({ Title = "Config Name", Content = "Name for a new config.", Placeholder = "e.g. Main Farm", Flag = "__wl_cfg_name", Save = false })
		nameBox.Save = false
		local pick = sec:AddDropdown({ Title = "Saved Configs", Content = "Pick one to load or delete.", Options = Config:List(), AllowNone = true, Placeholder = "None saved", Flag = "__wl_cfg_pick" })
		pick.Save = false
		local function refresh() pick:SetOptions(Config:List(), true) end
		local function chosen() return pick:Get() or (Config.Current) end
		sec:AddButton({ Title = "Save Config", Content = "Saves every setting under the name above.", Icon = "Floppy", Callback = function()
			local name = nameBox:Get() ~= "" and nameBox:Get() or pick:Get()
			local ok, err = Config:Save(name or "")
			if ok then refresh() pick:Set(Clean(name), true) Window:Notify({ Title = "Saved", Content = '"' .. Clean(name) .. '" holds every setting.', Type = "Success" })
			else Window:Notify({ Title = "Not saved", Content = err, Type = "Warn" }) end
		end })
		sec:AddButton({ Title = "Load Config", Content = "Applies the picked config now.", Icon = "Refresh", Callback = function()
			local name = pick:Get()
			if not name then return Window:Notify({ Title = "Pick a config", Content = "Choose one in Saved Configs first.", Type = "Warn" }) end
			local ok, n = Config:Load(name)
			Window:Notify(ok and { Title = "Loaded", Content = '"' .. name .. '" is active, ' .. tostring(n) .. " settings applied.", Type = "Success" } or { Title = "Not loaded", Content = n, Type = "Error" })
		end })
		local autoTg
		autoTg = sec:AddToggle({ Title = "Auto Load", Content = "Loads the picked config every time the script starts.", Flag = "__wl_cfg_auto", Default = Config:GetAutoLoad() ~= nil, Callback = function(v)
			if Config.Applying then return end
			if v then
				local name = pick:Get()
				if not name then
					Window:Notify({ Title = "Pick a config", Content = "Choose one in Saved Configs first.", Type = "Warn" })
					task.defer(function() autoTg:Set(false, true) end)
					return
				end
				Config:SetAutoLoad(name)
				Window:Notify({ Title = "Auto Load on", Content = '"' .. name .. '" loads on start.', Type = "Success" })
			else
				Config:SetAutoLoad(nil)
			end
		end })
		autoTg.Save = false
		if Config:GetAutoLoad() then pick:Set(Config:GetAutoLoad(), true) end
		sec:AddButton({ Title = "Copy Config", Content = "Copies every setting as text to share.", Icon = "Book", Callback = function()
			if SetClipboard(Config:Export()) then Window:Notify({ Title = "Copied", Content = "Config text is on your clipboard.", Type = "Success" })
			else Window:Notify({ Title = "Copy blocked", Content = "Your executor has no clipboard.", Type = "Warn" }) end
		end })
		local importBox = sec:AddInput({ Title = "Paste Config", Content = "Paste copied config text, then press Enter.", Placeholder = "Paste here", Flag = "__wl_cfg_import", Save = false, Callback = function(t)
			if t == "" then return end
			local ok, n = Config:Import(t)
			Window:Notify(ok and { Title = "Imported", Content = tostring(n) .. " settings applied.", Type = "Success" } or { Title = "Not imported", Content = n, Type = "Error" })
		end })
		importBox.Save = false
		sec:AddButton({ Title = "Delete Config", Content = "Removes the picked config from this device.", Icon = "Stop", Variant = "Danger", Callback = function()
			local name = pick:Get()
			if not name then return Window:Notify({ Title = "Pick a config", Content = "Choose one in Saved Configs first.", Type = "Warn" }) end
			Window:Dialog({ Title = 'Delete "' .. name .. '"?', Content = "This saved config is removed from this device. Your current settings stay as they are.", Confirm = "Delete", Danger = true,
				Callback = function() Config:Delete(name) refresh() pick:Set(nil, true) Window:Notify({ Title = "Deleted", Content = '"' .. name .. '" is gone.', Type = "Info" }) end })
		end })
		local ui = tab:AddSection({ Title = "Interface", Icon = "Key", Open = true })
		ui:AddKeybind({ Title = "Toggle Key", Content = "Shows or hides this window.", Default = Window.ToggleKey, WindowToggle = true, Flag = "__wl_toggle_key" })
		ui:AddDropdown({ Title = "UI Scale", Content = "Size of this window on your screen.", Options = { "80%", "90%", "100%", "110%", "120%" }, Default = "100%", Flag = "__wl_scale",
			Callback = function(v) Window:SetScale((tonumber(v:match("%d+")) or 100) / 100) end })
		if opts.Rejoin ~= false then
			ui:AddButton({ Title = "Rejoin Server", Content = "Rejoins the game after an update breaks something.", Icon = "Refresh", Callback = function()
				pcall(function() game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer) end)
			end })
		end
		return sec
	end
	local function reveal()
		if Window.Closed then return end
		Window:Show()
		if Mobile then Fab.Visible = true end
	end
	if INTRO.Enabled then
		task.spawn(function()
			PlayIntro(Gui, INTRO.Subtitle or ("Loading " .. GameName))
			reveal()
		end)
	else
		reveal()
	end

	task.delay(3, function() Config.Pending = nil end)
	return Window
end
return WisLib
